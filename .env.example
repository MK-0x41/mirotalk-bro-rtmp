# ============================================================================
# MiroTalk BRO — RTMP-Spezialinstanz: Beispiel-Umgebungsvariablen
#
# Kopieren nach `.env` und Werte anpassen. Diese Datei wird BOTH genutzt:
#   1. von docker compose für Interpolation (${BRO_INGEST_SECRET}, RTC-Ports),
#   2. read-only in den bro-Container gemountet (/src/.env) für die
#      BRO-Basiskonfiguration.
# NIEMALS echte Secrets in .env.example oder Git committen.
# ============================================================================

# --- Ingest-Secret (PFLICHT) -------------------------------------------------
# Schützt die interne external-ingest-API zwischen rtmp-adapter und BRO.
# Mindestens 16 Zeichen; erzeugen mit:  openssl rand -hex 32
# (Der Platzhalter `change-me` ist absichtlich zu kurz und scheitert an den
# Längenprüfungen; bekannte Beispiel-Werte aus der Doku werden zusätzlich
# per Denylist abgelehnt.)
BRO_INGEST_SECRET=change-me

# --- BRO-Basisapp -------------------------------------------------------------
NODE_ENV=production
PORT=3016

# SFU-Betrieb ist für die RTMP-Instanz zwingend (Ingest nur im SFU-Modus;
# wird zusätzlich per Compose-Umgebung erzwungen).
BROADCASTING=sfu

# API-Secret der BRO-REST-API (/api/v1/*):  openssl rand -hex 32
# (`change-me` ist absichtlich zu kurz und scheitert an der Längenprüfung.)
API_KEY_SECRET=change-me

# --- mediasoup (SFU) ----------------------------------------------------------
# Anzahl Worker; leer = Anzahl CPU-Kerne.
MEDIASOUP_NUM_WORKERS=
# RTC-Portbereich für Medien (TCP+UDP), muss mit den Compose-Ports übereinstimmen.
MEDIASOUP_RTC_MIN_PORT=40200
MEDIASOUP_RTC_MAX_PORT=40300
MEDIASOUP_LOG_LEVEL=error
# Im Container auf allen Interfaces lauschen; öffentliche Host-IP announce'n.
MEDIASOUP_LISTEN_IP=0.0.0.0
# Öffentliche IP des Hosts (Produktion zwingend setzen; Dev-VM: 192.168.56.5).
MEDIASOUP_ANNOUNCED_IP=

# --- rtmp-adapter (Optionales Tuning; Defaults gelten ohne Eintrag) -----------
# RECONCILE_INTERVAL_MS=2000
# Maximale Anzahl gleichzeitiger Ingests; neue Ingests werden erst gestartet,
# wenn wieder ein Slot frei ist (bestehende Ingests bleiben unberührt).
# MAX_CONCURRENT_INGESTS=4
# VIDEO_BITRATE=2500k
# AUDIO_BITRATE=128k
# KEYFRAME_SECONDS=2
# VIDEO_PRESET=veryfast
# LOG_LEVEL=info

# --- Rooms-API / RTMP-Registrierung (Fork) ------------------------------------
# ADMIN_TOKEN schützt die öffentlich erreichbare Rooms-API
# (/api/v1/rooms, Bearer) — PFLICHT für Raum-Anlage und Stream-Key-Rotation,
# da die API Stream-Keys vergibt. Erzeugen mit: openssl rand -hex 32
# (leer oder der dokumentierte Default = API antwortet 503, fail-closed;
# fehlgeschlagene Auth-Versuche werden pro IP ratenlimitiert: 10/60s → 429).
ADMIN_TOKEN=

# Obergrenze gleichzeitig registrierter RTMP-Räume.
RTMP_MAX_ROOMS=50

# Leer = aus dem Hostnamen der Anfrage abgeleitet: rtmps://<hostname>:1935/live
# (TRUST_PROXY=true beachtet X-Forwarded-Host korrekt; der Web-Port wird NICHT
# übernommen). Nur setzen, wenn der Ingest woanders terminiert.
RTMP_INGEST_URL=

# Ingest nur in registrierte RTMP-Räume (dynamische Stream-Key-Auth via
# Rooms-Registry). false nur für den statischen Fallback-Betrieb.
RTMP_REQUIRE_ROOM=true

# rtmp-adapter: dynamische Stream-Key-Autorisierung über die BRO-Rooms-API.
# Statischer keys.json-Betrieb (config/keys.json) erfordert das Paar
# RTMP_REQUIRE_ROOM=false UND RTMP_DYNAMIC_AUTH=false — beide Schalter
# gemeinsam umstellen, sonst startet der Ingest-Betrieb fail-closed.
RTMP_DYNAMIC_AUTH=true

# --- Logging / Betrieb --------------------------------------------------------
LOGS_JSON=false
LOGS_JSON_PRETTY=false
TRUST_PROXY=false
TZ=UTC
DEBUG=false
CORS_ORIGIN='*'
CORS_METHODS='["GET", "POST"]'

# --- STUN/TURN (Viewer/Browser-Broadcaster) -----------------------------------
# Produktionswerte im Installer-Repositorium pflegen; siehe auch
# .env.template des Upstream für OIDC/NGROK/SENTRY (hier bewusst weggelassen).
STUN_SERVER_ENABLED=true
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_ENABLED=false
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
